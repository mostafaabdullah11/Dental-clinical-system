# Development-only example. Copy to `.env` and replace every value.
# Never commit real passwords. Production uses Docker secrets (*_FILE), not this file.

# PostgreSQL superuser for the local development container (deploy/docker-compose.dev.yml)
POSTGRES_PASSWORD=change-me-dev-superuser

# Database role passwords created by deploy/db/bootstrap-roles.sql
CLINIC_MIGRATOR_PASSWORD=change-me-dev-migrator
CLINIC_APP_PASSWORD=change-me-dev-app
CLINIC_WORKER_PASSWORD=change-me-dev-worker
CLINIC_BACKUP_PASSWORD=change-me-dev-backup

# Connection strings (one per role; the api and worker never receive the migrator password)
ConnectionStrings__Clinic=Host=localhost;Port=5432;Database=clinic;Username=clinic_app;Password=change-me-dev-app
ConnectionStrings__ClinicWorker=Host=localhost;Port=5432;Database=clinic;Username=clinic_worker;Password=change-me-dev-worker
CLINIC_MIGRATOR_CONNECTION=Host=localhost;Port=5432;Database=clinic;Username=clinic_migrator;Password=change-me-dev-migrator

# Integration tests: an administrative connection used only to create and drop throwaway test databases
# and to run the role bootstrap. Point it at a local development server, never at staging or production.
CLINIC_TEST_PG_ADMIN=Host=localhost;Port=5432;Username=postgres;Password=change-me-dev-superuser
