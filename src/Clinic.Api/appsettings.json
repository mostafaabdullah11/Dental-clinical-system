{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Clinic": ""
  },
  "Security": {
    "AllowedOrigins": [],
    "TrustedProxyNetworks": [],
    "RateLimits": {
      "AuthPerIpPerMinute": 10,
      "GeneralPerUserPerMinute": 300
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutDuration": "00:15:00"
    },
    "Session": {
      "IdleTimeout": "00:20:00",
      "AbsoluteTimeout": "10:00:00"
    }
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePasswordFile": ""
  }
}
