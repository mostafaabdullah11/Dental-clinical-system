# syntax=docker/dockerfile:1.7
# clinic-migrator: the one-shot schema migrator (DEPLOYMENT_ARCHITECTURE.md §1.2, §2.5). Started only by the deploy script
# (`docker compose --profile migrate run --rm migrator`) with the clinic_migrator secret; never running in normal operation.
# The same compiled migrations CI applied to an empty database and to the previous release's database.

FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/ src/
RUN dotnet restore src/Clinic.Migrator/Clinic.Migrator.csproj \
 && dotnet publish src/Clinic.Migrator/Clinic.Migrator.csproj -c Release -o /out --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled@sha256:c89a6a61f494f20a5ae302990e814627a8d91b332fd4a8e7c1707c2d4da9555d
WORKDIR /app
COPY --from=build --chown=1654:1654 /out ./
ENV DOTNET_RUNNING_IN_CONTAINER=true TZ=UTC \
    CLINIC_MIGRATOR_CONNECTION_FILE=/run/secrets/migrator_db_conn
USER 1654
ENTRYPOINT ["dotnet", "Clinic.Migrator.dll"]
